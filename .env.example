# ---------------------------------------------------------------------------
# TikTok Content Posting API - configuration template
# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. The real `.env` is
# gitignored and must never be committed.
# ---------------------------------------------------------------------------

# From your app's Basic information / credentials page at developers.tiktok.com:
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here

# Must EXACTLY match a Redirect URI configured under Login Kit:
TIKTOK_REDIRECT_URI=https://your-app.example.com/callback

# Filled in after running the OAuth `token` command:
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=
